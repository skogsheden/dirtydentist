[bootstrap]
main_collection = /example/new_test.collectionc

[script]
shared_state = 1

[display]
width = 1280
height = 800
update_frequency = 60
display_device_info = 1
fullscreen = 0
high_dpi = 1

[project]
title = DD-GUI
version = 0.3.3
publisher = Skogsheden
developer = Nils Gustafsson
bundle_resources = /dd-gui/
dependencies#0 = https://github.com/d954mas/defold-utf8/archive/master.zip

[library]
include_dirs = dirtydentist, dd-gui

[html5]
htmlfile = /dd-gui/HTML/engine_template.html
splash_image = /logo.png
scale_mode = downscale_fit

[graphics]
max_font_batches = 256
default_texture_min_filter = linear_mipmap_linear
default_texture_mag_filter = linear

